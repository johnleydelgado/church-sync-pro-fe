# Use a Node 16 base image
FROM --platform=linux/amd64 node:16-slim AS base

FROM base AS deps
WORKDIR /app
# Increase npm timeout to avoid network-related issues
RUN npm config set timeout 60000
# Copy app files
COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./
RUN \
  if [ -f yarn.lock ]; then yarn --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci --legacy-peer-deps; \
  elif [ -f pnpm-lock.yaml ]; then yarn global add pnpm && pnpm i; \
  else echo "Lockfile not found." && exit 1; \
  fi

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM base AS runner
WORKDIR /app
COPY --from=builder /app/build ./build
# Copy package.json to install 'serve' or any required packages
COPY package.json ./
# Set npm timeout before installing 'serve'
RUN npm config set timeout 60000
# Install serve globally. A local `npm install serve` reads this project's
# package.json overrides (which use the $react alias) in a directory with no
# node_modules and fails with "Unable to resolve reference $react".
RUN npm install -g serve

EXPOSE 3000
ENV PORT 3000

CMD [ "serve", "-s", "build" ]
