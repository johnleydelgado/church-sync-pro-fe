# ==== CONFIGURE =====
# Use a Node 16 base image
FROM node:16-alpine 
# Set the working directory to /app inside the container
WORKDIR /app
# Copy app files
COPY . .
# `react-scripts build` forces NODE_ENV=production, so CRA reads .env.production and
# ignores .env.staging entirely. Without this the staging image is built with
# production values and points at the production backend.
RUN cp .env.staging .env.production
# ==== BUILD =====
# Install dependencies (npm ci makes sure the exact versions in the lockfile gets installed)
RUN npm ci --legacy-peer-deps
# Build the app
RUN PUBLIC_URL=/ npm run build
# ==== RUN =======
# Set the env to "production"
ENV NODE_ENV staging
# Expose the port on which the app will be running (3000 is the default that `serve` uses)
EXPOSE 3000
# Start the app
CMD [ "npx", "serve", "-s", "build" ]