# Church Sync Pro — Web Client environment variables
# Copy this file to `.env.development`, `.env.staging`, or `.env.production`
# and fill in the values. CRA only exposes variables prefixed with REACT_APP_.

# App name (also used to namespace localStorage keys)
REACT_APP_NAME_PROJECT=church-sync-pro

# Backend API host and base path
REACT_APP_HOST_BE=http://localhost:8080
REACT_APP_API_PATH=http://localhost:8080/csp/

# Google OAuth callback URL (must match the value configured in Google Cloud)
REACT_APP_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback/google

# Stripe publishable key
REACT_APP_STRIPE_PUB_KEY=pk_test_your_stripe_publishable_key
